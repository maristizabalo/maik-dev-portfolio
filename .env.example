# === Sitio ===
# URL pública del sitio (sin barra final). Ej: https://mjaris.vercel.app
NEXT_PUBLIC_SITE_URL=

# === Supabase (servidor) ===
# Project URL y service_role key. NUNCA expongas la service_role al cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Estas dos son públicas (el sitio no las usa para escribir, pero quedan disponibles).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === Asistente de IA ===
# Proveedor activo: "anthropic" u "openai". Si se deja vacío, el asistente usa el
# modo fallback local (responde con la base de conocimiento sin costo).
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Modelo a usar (ej: claude-3-5-sonnet-latest o gpt-4o-mini).
AI_MODEL=

# === Consola privada ===
# Ruta de la consola (por defecto "console"). Si la cambias, renombra también
# la carpeta src/app/console para que coincida.
CONSOLE_PATH=console
# Hash de la contraseña. Genéralo con: node scripts/hash-password.mjs "tu-clave"
CONSOLE_PASSWORD_HASH=
# Secreto largo y aleatorio para firmar el JWT de sesión.
CONSOLE_JWT_SECRET=
CONSOLE_SESSION_HOURS=12

# === Analítica ===
# Salt secreto para hashear IPs (nunca se guarda la IP en crudo).
ANALYTICS_SALT=
# "false" para desactivar la analítica por completo.
ANALYTICS_ENABLED=true
# Token para proteger el endpoint de agregación (cron).
CRON_SECRET=

# === Contacto (públicos) ===
NEXT_PUBLIC_WHATSAPP_NUMBER=573106890460
NEXT_PUBLIC_CONTACT_EMAIL=maristizabalo95@gmail.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/maristizabalo
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/maicol-aristizabal/
NEXT_PUBLIC_CALENDLY_URL=

# === Notificaciones de correo (opcional) ===
# Si defines ambas, el formulario de contacto envía un correo con Resend.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
